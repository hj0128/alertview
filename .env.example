# --- Telegram (★ 필수: BotFather에서 발급) ---
TELEGRAM_BOT_TOKEN=PUT_YOUR_TOKEN_HERE
TELEGRAM_BOT_USERNAME=PUT_YOUR_BOT_USERNAME

# --- Collector ---
POLL_INTERVAL=300
DEMO=0

# --- Database ---
# DATABASE_URL 을 채우면 PostgreSQL 사용(운영/도커). 비워두면 SQLite(DB_PATH) 폴백.
# 로컬에서 직접 postgres 에 붙을 땐 예: postgresql://alertview:alertview@localhost:5432/alertview
# docker-compose 사용 시에는 compose 가 자동으로 DATABASE_URL 을 주입하므로 여기선 비워둬도 됩니다.
DATABASE_URL=
DB_PATH=data.db

# docker-compose 의 postgres 컨테이너 자격증명(앱의 DATABASE_URL 도 이 값으로 구성됨)
POSTGRES_USER=alertview
POSTGRES_PASSWORD=alertview
POSTGRES_DB=alertview
# 호스트에서 웹 UI 에 접속할 포트(컨테이너 내부는 8000 고정)
HOST_PORT=8000
# 호스트에서 PostgreSQL(DBeaver 등)로 접속할 포트. 로컬에 이미 5432 를 쓰면 5433 등으로 변경
DB_HOST_PORT=5432

# --- Web UI ---
WEB_ENABLED=1
WEB_PORT=8000
WEB_SECRET=please-set-a-long-random-string

# --- Local test only: skip Telegram login (set 0 in production) ---
WEB_DEV_LOGIN=0
# Your Telegram numeric id (from @userinfobot) so dev login = you, alerts reach you
WEB_DEV_CHATID=
DQ_MAX_PAGES=0
